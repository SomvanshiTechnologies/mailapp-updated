# ---------- Runtime ----------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Public URL of the API (used for unsubscribe links and SNS subscription)
PUBLIC_BASE_URL=http://localhost:4000
# Origin of the dashboard (CORS)
WEB_ORIGIN=http://localhost:5173

# ---------- Database ----------
DATABASE_URL=postgres://mailapp:mailapp@localhost:5433/mailapp

# ---------- Auth ----------
# 32+ random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-change-me-change-me-change-me-change-me
# Used to sign unsubscribe tokens and other HMACs
APP_SECRET=change-me-too-change-me-too-change-me-too
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
# Initial admin created by `npm run db:seed` if no users exist
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe!12345

# ---------- Models (Anthropic / OpenAI / Gemini / DeepSeek) ----------
# live = use the model chosen in Settings (any provider with a key below)
# mock = force the offline provider; no network calls, nothing charged
LLM_PROVIDER=mock
# A key can also be added from the dashboard (Settings -> Model providers), which takes
# precedence over these and can be rotated without a redeploy.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Optional base-URL overrides for gateways or compatible self-hosted endpoints
OPENAI_BASE_URL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Default models, as "<provider>:<model>"; append "@batch" to route through the provider's
# batch endpoint at half price (results arrive later, not immediately).
LLM_MODEL=anthropic:claude-opus-5-5
LLM_RESEARCH_MODEL=anthropic:claude-opus-5-5
LLM_MAX_CONCURRENCY=3
# Use server-side web search during research, on models that support it (true/false)
LLM_WEB_SEARCH=true
# How many provider batches the once-a-minute tick submits or polls per run
LLM_BATCH_MAX_PER_TICK=5
# Give up on a batch after this many one-a-minute polls (1500 = ~25h, just past the 24h window)
LLM_BATCH_MAX_POLL_ATTEMPTS=1500

# ---------- AWS / SES ----------
AWS_REGION=us-east-1
# Leave credentials empty to use the default provider chain (IAM role, profile, etc.)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# ses | mock   (mock = dry-run: nothing leaves the machine, fake message ids)
SES_MODE=mock
SES_CONFIGURATION_SET=mailapp-events
SES_FROM_EMAIL=outreach@example.com
SES_FROM_NAME=Outreach Team
SES_REPLY_TO=replies@example.com
# Hard ceiling per 24h across all campaigns (SES quota is also enforced)
SES_DAILY_CAP=2000
# Max sends per second (never exceeds SES MaxSendRate)
SES_MAX_SEND_RATE=5
# Inbound: S3 bucket where SES receipt rule stores raw emails (optional)
SES_INBOUND_BUCKET=
SES_INBOUND_PREFIX=inbound/
# SNS topic ARNs allowed to call the webhooks (comma separated). Empty = accept any *verified* SNS message.
SNS_ALLOWED_TOPIC_ARNS=

# ---------- Reply capture ----------
# Domain whose MX points at SES inbound (e.g. reply.example.com). When set, campaigns without an
# explicit Reply-To use <sender-local-part>@<this domain> so replies reach the app.
SES_INBOUND_DOMAIN=

# Organisation-wide IMAP mailbox to poll (optional; users can also configure their own mailbox in My profile)
IMAP_ENABLED=false
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX

# ---------- Storage ----------
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_S3_BUCKET=
STORAGE_S3_PREFIX=mailapp/

# ---------- Observability ----------
# Push custom metrics to CloudWatch (namespace MailApp)
CLOUDWATCH_METRICS_ENABLED=false
CLOUDWATCH_NAMESPACE=MailApp
# Pull SES metrics from CloudWatch into the dashboard
CLOUDWATCH_SES_METRICS_ENABLED=false

# ---------- Worker ----------
WORKER_RESEARCH_CONCURRENCY=2
WORKER_DRAFT_CONCURRENCY=2
WORKER_SEND_CONCURRENCY=2
