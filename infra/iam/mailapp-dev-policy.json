{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SesSendViaApiV2",
      "Effect": "Allow",
      "Action": ["ses:SendEmail", "ses:SendRawEmail"],
      "Resource": [
        "arn:aws:ses:${AWS_REGION}:${AWS_ACCOUNT_ID}:identity/*",
        "arn:aws:ses:${AWS_REGION}:${AWS_ACCOUNT_ID}:configuration-set/*"
      ]
    },
    {
      "Sid": "SesAccountAndSuppression",
      "Effect": "Allow",
      "Action": [
        "ses:GetAccount",
        "ses:GetConfigurationSet",
        "ses:ListConfigurationSets",
        "ses:GetEmailIdentity",
        "ses:ListEmailIdentities",
        "ses:PutSuppressedDestination",
        "ses:GetSuppressedDestination",
        "ses:ListSuppressedDestinations",
        "ses:DeleteSuppressedDestination",
        "ses:BatchGetMetricData"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudWatchPutAppMetrics",
      "Effect": "Allow",
      "Action": "cloudwatch:PutMetricData",
      "Resource": "*",
      "Condition": { "StringEquals": { "cloudwatch:namespace": "MailApp" } }
    },
    {
      "Sid": "CloudWatchReadSesMetrics",
      "Effect": "Allow",
      "Action": ["cloudwatch:GetMetricData", "cloudwatch:GetMetricStatistics", "cloudwatch:ListMetrics"],
      "Resource": "*"
    },
    {
      "Sid": "StorageBucketReadWrite",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:GetObjectVersion", "s3:AbortMultipartUpload"],
      "Resource": ["arn:aws:s3:::${STORAGE_BUCKET}/*", "arn:aws:s3:::${INBOUND_BUCKET}/*"]
    },
    {
      "Sid": "BucketList",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::${STORAGE_BUCKET}", "arn:aws:s3:::${INBOUND_BUCKET}"]
    },
    {
      "Sid": "ReadAppSecrets",
      "Effect": "Allow",
      "Action": ["secretsmanager:GetSecretValue", "secretsmanager:DescribeSecret"],
      "Resource": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:mailapp/*"
    },
    {
      "Sid": "WriteLogsFromLocalRuns",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents", "logs:DescribeLogStreams"],
      "Resource": "arn:aws:logs:${AWS_REGION}:${AWS_ACCOUNT_ID}:log-group:/mailapp/*"
    },
    {
      "Sid": "SnsSubscriptionManagementForWebhookTesting",
      "Effect": "Allow",
      "Action": ["sns:Subscribe", "sns:ConfirmSubscription", "sns:ListSubscriptionsByTopic", "sns:GetTopicAttributes"],
      "Resource": "arn:aws:sns:${AWS_REGION}:${AWS_ACCOUNT_ID}:mailapp-*"
    }
  ]
}
